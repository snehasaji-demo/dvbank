# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:///./test.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Read by the backend code (DVBANK_FLAG_DIR)
DVBANK_FLAG_DIR=/tmp/dvbank_ctf
# Read by the backend code (DVBANK_SSRF_PORT)
DVBANK_SSRF_PORT=8009
# Read by the backend code (DVBANK_URL)
DVBANK_URL=http://localhost:5000
# Read by the backend code (VPY)
VPY=/tmp/claude-1000/-home-mamgad-DVBank/4f8ac8a6-a8c7-4b49-b1af-9e3fabad69b0/
